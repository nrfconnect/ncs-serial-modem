&pinctrl {
	uart0_default_nrf9151_mk_bg95: uart0_default_nrf9151_mk_bg95 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 15)>,
				<NRF_PSEL(UART_RTS, 0, 18)>;
		};
		group2 {
			psels = <NRF_PSEL(UART_RX, 0, 14)>,
				<NRF_PSEL(UART_CTS, 0, 19)>;
			bias-pull-up;
		};
	};

	uart0_sleep_nrf9151_mk_bg95: uart0_sleep_nrf9151_mk_bg95 {
		group1 {
			psels = <NRF_PSEL(UART_TX, 0, 15)>,
				<NRF_PSEL(UART_RX, 0, 14)>,
				<NRF_PSEL(UART_RTS, 0, 18)>,
				<NRF_PSEL(UART_CTS, 0, 19)>;
			low-power-enable;
		};
	};
};

&uart0 {
	status = "okay";
	/delete-property/ hw-flow-control;
	pinctrl-0 = <&uart0_default_nrf9151_mk_bg95>;
	pinctrl-1 = <&uart0_sleep_nrf9151_mk_bg95>;
	pinctrl-names = "default", "sleep";
};

/* Disable external flash */
&gd25wb256 {
	status = "disabled";
};

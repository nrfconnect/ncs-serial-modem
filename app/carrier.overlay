 *
 * Flash partition overlay for nRF9151DK with LwM2M carrier partition.
 *
 * LwM2M carrier utilizes the memfault coredump partition as a lwM2M settings partition
 * and falls back to a RAM-backed coredump.
 */

/ {
	chosen {
		nordic,lwm2m-carrier-partition = &lwm2m_carrier_partition;
		zephyr,settings_partition = &settings_storage_partition;
		/delete-property/ nordic,memfault-coredump-partition;
	};
};

/delete-node/ &memfault_coredump_partition;

&storage_partition {
	compatible = "zephyr,mapped-partition";
	label = "storage";
	reg = <0x000fb000 0x5000>;
	ranges = <0x0 0x000fb000 0x5000>;
	#address-cells = <1>;
	#size-cells = <1>;

	lwm2m_carrier_partition: partition@0 {
		compatible = "zephyr,mapped-partition";
		label = "lwm2m-carrier";
		reg = <0x00000000 0x3000>;
	};

	settings_storage_partition: partition@3000 {
		compatible = "zephyr,mapped-partition";
		label = "settings-storage";
		reg = <0x00003000 0x2000>;
	};
};

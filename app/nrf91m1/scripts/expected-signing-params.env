# Expected signing parameters for nrf9151dk/nrf9151 (nRF9151 M1 / CELL / REV0).
# Board-specific, hardware-derived values captured from a known-good build.
#
# sign_build_unsigned.py compares every parsed parameter against this file and
# aborts if any value differs. Update this file (with a conscious review) when:
#   - NCS version is upgraded and changes partition layout or magic values
#   - Board DTS is changed to resize partitions
#   - SoC variant changes (different UICR address etc.)
#
# APP_VERSION and MCUBOOT_VERSION are intentionally omitted — they change
# with every release and are not hardware-derived.

# NSIB validation_data parameters
MAGIC_VALUE=0x281ee6de,0x86518483,88834
VAL_SKIP=0x200
VAL_OFFSET=0

# MCUboot slot (imgtool sign parameters)
MCUBOOT_SLOT_SIZE=49152
MCUBOOT_HEADER_SIZE=0x200
MCUBOOT_ALIGN=4

# B0 provisioning
PROV_S0_ADDR=0x8000
PROV_S1_ADDR=0x14000
PROV_ADDR=0xff8108
PROV_MAX_SIZE=0x280
PROV_COUNTER_SLOTS=40
PROV_OTP_WIDTH=2

# Application slot (imgtool sign parameters)
APP_SLOT_SIZE=0x6f000
APP_HEADER_SIZE=0x200
APP_ALIGN=4
APP_LOAD_ADDR=0x20000

# Symbols used by sm_at_mqtt.c that are normally gated behind SM_MQTTC
# (which selects MQTT_LIB and thus the full socket stack). Defined here
# without parent constraints so the test build can set them while keeping
# the MQTT library mocked.

config SM_MQTTC_MESSAGE_BUFFER_LEN
	int "Size of the MQTT RX/TX buffers"
	default 512
	range 1 65536

config MQTT_KEEPALIVE
	int "MQTT keep-alive interval (seconds)"
	default 60

config MQTT_CLEAN_SESSION
	bool "MQTT clean session"
	default n

# SM core symbols — normally defined inside menu "Nordic Serial Modem" in
# app/Kconfig.  Redefined here as standalone symbols because the app Kconfig
# cannot be rsourced (it owns mainmenu and sources Kconfig.zephyr itself).

# NRF_MODEM_LIB_MEM_DIAG is normally gated by NRF_MODEM_LIB; define it here
# so the nrf_modem_lib_diag_stats mock compiles with the full struct definition.
config NRF_MODEM_LIB_MEM_DIAG
	bool "modem lib diagnostics"

config SM_CUSTOMER_VERSION
	string "Customer version string"

config SM_AT_BUF_SIZE
	int "AT command buffer size"
	range 128 8192
	default 4096

config SM_URC_BUFFER_SIZE
	int "URC TX buffer size"
	default 4096

config SM_DATAMODE_BUF_SIZE
	int "Data mode buffer size"
	range 1024 8192
	default 4096

config SM_DATAMODE_TERMINATOR
	string "Data mode terminator pattern"
	default "+++"

# Integer log level: 0=off 1=err 2=wrn 3=inf 4=dbg (Zephyr log_config template)
config SM_LOG_LEVEL
	int "Log level"
	default 3

config SM_CR_LF_TERMINATION
	bool "CR+LF termination"

config SM_URC_DELAY_WITH_INCOMPLETE_ECHO_MS
	int "URC delay with incomplete echo (ms)"
	default 1000

config SM_AT_ECHO_MAX_LEN
	int "Maximum AT command echo length"
	range 2 4096
	default 4096

config SM_UART_RX_BUF_SIZE
	int "UART RX buffer size"
	range 128 4096
	default 256

config SM_UART_TX_BUF_SIZE
	int "UART TX buffer size"
	range 128 4096
	default 256

config SM_CMUX_CHANNEL_COUNT
	int "CMUX channel count"
	default 1

# subsys/net/ip/Kconfig is not sourced when the network stack is disabled,
# so define this symbol explicitly to get the AF_INET/SOCK_STREAM etc. aliases.
config NET_NAMESPACE_COMPAT_MODE
	bool "Network namespace compatibility mode"
	default y

source "Kconfig.zephyr"
